# ─────────────────────────────────────────────────────────────
# Smart HR Management System — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# ─────────────────────────────────────────────────────────────

# MongoDB Atlas connection string (required)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/smart_hr?retryWrites=true&w=majority

# Flask security keys — generate strong random strings for production
SECRET_KEY=change-this-to-a-random-secret-key
JWT_SECRET_KEY=change-this-to-a-random-jwt-key

# Token expiry (seconds)
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=86400

# Flask environment
FLASK_ENV=development
FLASK_DEBUG=True

# OpenAI (optional — leave blank to use rule-based AI fallback)
OPENAI_API_KEY=

# Email / SMTP (optional — for notifications)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Server port
PORT=5000
